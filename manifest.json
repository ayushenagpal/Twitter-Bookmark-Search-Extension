{
  "manifest_version": 3,
  "name": "Threadfinder",
  "version": "1.0.0",
  "description": "A private, local search index for your X bookmarks.",
  "permissions": ["storage", "tabs", "unlimitedStorage"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Search bookmarks", "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["https://x.com/*", "https://twitter.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
